class Readyci < Formula
  desc "Remote local CI runner for fast, isolated project checks"
  homepage "https://readyci.com"
  version "{{VERSION}}"
  license "Apache-2.0"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/DeanStr/readyci-cli/releases/download/#{version}/readyci_darwin_arm64.tar.gz"
      sha256 "{{DARWIN_ARM64_SHA256}}"
    else
      url "https://github.com/DeanStr/readyci-cli/releases/download/#{version}/readyci_darwin_amd64.tar.gz"
      sha256 "{{DARWIN_AMD64_SHA256}}"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/DeanStr/readyci-cli/releases/download/#{version}/readyci_linux_arm64.tar.gz"
      sha256 "{{LINUX_ARM64_SHA256}}"
    else
      url "https://github.com/DeanStr/readyci-cli/releases/download/#{version}/readyci_linux_amd64.tar.gz"
      sha256 "{{LINUX_AMD64_SHA256}}"
    end
  end

  def install
    bin.install "readyci"
    doc.install "README.md", "INSTALL.md", "SECURITY.md"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/readyci version")
  end
end
