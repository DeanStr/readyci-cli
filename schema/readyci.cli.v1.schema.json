{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readyci.com/schema/readyci.cli.v1.schema.json",
  "title": "Ready CI CLI error result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "ok",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "readyci.cli.v1"
    },
    "command": {
      "type": "string"
    },
    "ok": {
      "const": false
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "classification",
        "retryable",
        "message",
        "next_actions"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "cancellation_acknowledged": {
          "type": "boolean"
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
