{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readyci.com/schema/readyci.cli.v1.schema.json",
  "title": "Ready CI CLI error result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "ok",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "readyci.cli.v1"
    },
    "command": {
      "type": "string"
    },
    "ok": {
      "const": false
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "classification",
        "retryable",
        "message",
        "next_actions"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "request": {"$ref": "#/$defs/apiRequestDiagnostics"},
        "message": {
          "type": "string",
          "minLength": 1
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "cancellation_acknowledged": {
          "type": "boolean"
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "apiRequestDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "description": "Client observations, not a diagnosis or authorization. Contains no origin, query, headers, body or network addresses.",
      "required": ["method", "path", "request_id", "phase", "elapsed_ms", "timeout_ms"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "pattern": "^cli_[0-9a-f]{32}$"},
        "server_request_id": {"type": "string", "pattern": "^req_[0-9a-f]{32}$"},
        "phase": {"enum": ["request", "connection_acquisition", "dns", "connect", "tls_handshake", "request_write", "response_headers", "response_body"]},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "timeout_ms": {"type": "integer", "minimum": 0},
        "status_code": {"type": "integer", "minimum": 100, "maximum": 599},
        "connection_reused": {"type": "boolean"},
        "response_body_incomplete": {"type": "boolean"}
      }
    }
  }
}
