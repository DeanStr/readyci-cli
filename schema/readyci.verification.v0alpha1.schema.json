{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readyci.com/schema/readyci.verification.v0alpha1.schema.json",
  "title": "Ready CI agent verification protocol",
  "description": "Pre-release machine contract for durable verification sessions and agent-facing reports.",
  "oneOf": [
    {
      "$ref": "#/$defs/verificationSession"
    },
    {
      "$ref": "#/$defs/agentPlanReport"
    },
    {
      "$ref": "#/$defs/agentVerifyReport"
    },
    {
      "$ref": "#/$defs/agentExplainReport"
    },
    {
      "$ref": "#/$defs/agentArtifactHandoffReport"
    },
    {
      "$ref": "#/$defs/agentInstructionsDoctorReport"
    }
  ],
  "$defs": {
    "apiRequestDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "description": "Client observations, not a diagnosis or authorization. Contains no origin, query, headers, body or network addresses.",
      "required": ["method", "path", "request_id", "phase", "elapsed_ms", "timeout_ms"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "pattern": "^cli_[0-9a-f]{32}$"},
        "server_request_id": {"type": "string", "pattern": "^req_[0-9a-f]{32}$"},
        "phase": {"enum": ["request", "connection_acquisition", "dns", "connect", "tls_handshake", "request_write", "response_headers", "response_body"]},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "timeout_ms": {"type": "integer", "minimum": 0},
        "status_code": {"type": "integer", "minimum": 100, "maximum": 599},
        "connection_reused": {"type": "boolean"},
        "response_body_incomplete": {"type": "boolean"}
      }
    },
    "verificationClientError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "classification", "retryable", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "retry_after_seconds": {"type": "integer", "minimum": 0},
        "request": {"$ref": "#/$defs/apiRequestDiagnostics"},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "testReportSelection": {
      "type": "object", "additionalProperties": false,
      "description": "Observed and omitted diagnostics from bounded report discovery. When scan_complete is false, observations and omissions are lower bounds; counts elsewhere still describe retained indexed cases only.",
      "required": ["reports_observed", "reports_omitted", "results_observed", "results_omitted", "observed_counts", "scan_complete"],
      "properties": {
        "reports_observed": {"type": "integer", "minimum": 0},
        "reports_omitted": {"type": "integer", "minimum": 0},
        "results_observed": {"type": "integer", "minimum": 0},
        "results_omitted": {"type": "integer", "minimum": 0},
        "observed_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["passed", "failed", "errors", "skipped"],
          "properties": {
            "passed": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0},
            "errors": {"type": "integer", "minimum": 0},
            "skipped": {"type": "integer", "minimum": 0}
          }
        },
        "scan_complete": {"type": "boolean"}
      }
    },
    "artifactRetention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "matched_file_count", "retained_file_count", "omitted_file_count", "omitted_report_count", "omitted_files"],
      "properties": {
        "schema_version": {"const": "readyci.artifact_retention.v1"},
        "matched_file_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "retained_file_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "omitted_file_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "omitted_report_count": {"type": "integer", "minimum": 0, "maximum": 100000, "description": "Omitted report candidates identified by path, not observed test executions."},
        "failed_workspace_omitted": {"type": "boolean"},
        "omissions_truncated": {"type": "boolean"},
        "unmatched_paths": {
          "type": "array", "maxItems": 100000, "uniqueItems": true,
          "description": "Configured literal paths that matched no source files, independent of bounded collection omissions.",
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "omitted_files": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "size_bytes", "reason"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 4096},
              "size_bytes": {"type": "integer", "minimum": 0},
              "reason": {"const": "bundle_limit"}
            }
          }
        }
      }
    },
    "runtimeDiagnostics": {
      "type": "object", "additionalProperties": false,
      "description": "A bounded claim-scoped failed-runtime snapshot; not execution evidence or proof of guest OOM.",
      "required": ["schema_version", "instance_id", "trigger", "captured_at", "launcher", "logs", "vm_resources", "limitations"],
      "properties": {
        "schema_version": {"const": "readyci.runtime_diagnostics.v1"},
        "instance_id": {"type": "string"},
        "trigger": {"type": "string"},
        "captured_at": {"type": "string", "format": "date-time"},
        "launcher": {
          "type": "object", "additionalProperties": false,
          "required": ["scope", "exited", "observed_before_teardown", "exit_code"],
          "properties": {
            "scope": {"type": "string"},
            "exited": {"type": "boolean"},
            "observed_before_teardown": {"type": "boolean"},
            "exit_code": {"type": ["integer", "null"]},
            "signal": {"type": "string"},
            "unavailable": {"type": "string"}
          }
        },
        "logs": {
          "type": "object", "maxProperties": 3,
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["observed_bytes", "retained_bytes", "truncated"],
            "properties": {
              "data_base64": {"type": "string", "contentEncoding": "base64"},
              "observed_bytes": {"type": "integer", "minimum": 0},
              "retained_bytes": {"type": "integer", "minimum": 0, "maximum": 8192},
              "truncated": {"type": "boolean"},
              "unavailable": {"type": "string"}
            }
          }
        },
        "vm_resources": {"type": "object"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "phaseTimings": {
      "type": "object",
      "additionalProperties": false,
      "description": "Request-local diagnostic monotonic wall-clock spans; nested spans overlap and unobserved phases are null. Excluded from verification evidence.",
      "required": ["basis", "phases_ms"],
      "properties": {
        "basis": {"enum": ["api_monotonic", "worker_monotonic"]},
        "phases_ms": {"type": "object", "additionalProperties": {"type": ["integer", "null"], "minimum": 0}}
      }
    },
    "schemaVersion": {
      "const": "readyci.verification.v0alpha1"
    },
    "environmentRequirements": {
      "type": "array",
      "maxItems": 32,
      "items": {"enum": ["filesystem:btrfs", "filesystem:minix", "network:ipv6-loopback", "network:ipv6-interface"]}
    },
    "intent": {
      "enum": [
        "edit-loop",
        "pre-commit",
        "pre-pr",
        "fixture-update",
        "security-sensitive",
        "final-handoff"
      ]
    },
    "verificationSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "session_id", "idempotency_key", "project_id", "state", "verdict", "assurance", "currentness", "recipe", "secrets_requested", "secrets_authorized", "source_ready", "snapshot", "coverage", "plan", "nodes", "created_at", "updated_at"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "session_id": {"type": "string", "minLength": 1},
        "idempotency_key": {"type": "string", "minLength": 1},
        "task_id": {"type": "string"},
        "team_id": {"type": "string"},
        "project_id": {"type": "string", "minLength": 1},
        "predecessor_id": {"type": "string"},
        "successor_id": {"type": "string"},
        "source_ready": {"type": "boolean"},
        "snapshot_retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "successor_id"],
          "properties": {
            "action": {"enum": ["resume", "open_successor"]},
            "successor_id": {"type": "string", "minLength": 1}
          }
        },
        "intent": {"type": "string"},
        "goal": {"type": "string"},
        "recipe": {"$ref": "#/$defs/verificationRecipe"},
        "secrets_requested": {"type": "boolean"},
        "secrets_authorized": {"type": "boolean"},
        "state": {"enum": ["open", "sealed", "terminal"]},
        "verdict": {"enum": ["pending", "verified", "checks_passed", "failed", "insufficient_evidence", "no_change_required", "no_verification_needed", "blocked", "stale", "cancelled"]},
        "assurance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "execution", "evaluator"],
          "properties": {
            "scope": {"const": "configured_checks"},
            "execution": {"enum": ["pending", "production_runner_receipt", "not_established"]},
            "evaluator": {"const": "candidate_workspace_unassessed"}
          }
        },
        "classification": {"type": "string"},
        "terminal_reason": {"type": "string"},
        "currentness": {"enum": ["current", "stale"]},
        "current_snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "currentness_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "observed_snapshot_digest", "observed_at", "observed_by"],
          "properties": {
            "state": {"enum": ["current", "stale"]},
            "observed_snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "observed_at": {"type": "string", "format": "date-time"},
            "observed_by": {"enum": ["user", "token", "team"]}
          }
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "dirty", "change_mode", "changed_files"],
          "properties": {
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "git_head": {"type": "string"},
            "git_branch": {"type": "string"},
            "dirty": {"type": "boolean"},
            "change_mode": {"enum": ["working", "staged", "all"]},
            "changed_files": {"type": "array", "items": {"type": "string"}}
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matched_files", "ignored_files", "uncovered_files"],
          "properties": {
            "matched_files": {"type": "array", "items": {"type": "string"}},
            "ignored_files": {"type": "array", "items": {"type": "string"}},
            "uncovered_files": {"type": "array", "items": {"type": "string"}}
          }
        },
        "plan": {"$ref": "#/$defs/verificationPlan"},
        "proposed_plan": {"$ref": "#/$defs/verificationPlan"},
        "plan_authorization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {"type": "string"},
            "policy_digest": {"type": "string"},
            "base_commit": {"type": "string"},
            "planner_version": {"type": "string"}
          }
        },
        "plan_divergence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "added_nodes": {"type": "array", "items": {"type": "string"}},
            "removed_nodes": {"type": "array", "items": {"type": "string"}},
            "changed_commands": {"type": "array", "items": {"type": "string"}},
            "changed_coverage": {"type": "array", "items": {"type": "string"}},
            "changed_policy": {"type": "array", "items": {"type": "string"}}
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "kind", "required", "status", "scheduling", "attempts"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "status": {"type": "string", "minLength": 1},
              "scheduling": {
                "type": "object",
                "additionalProperties": false,
                "required": ["state"],
                "properties": {
                  "state": {
                    "enum": ["ready", "waiting_for_dependency", "waiting_for_matrix_slot", "retry_pending", "active", "skipped_dependency", "skipped_plan_fail_fast", "skipped_matrix_fail_fast", "terminal"]
                  },
                  "reason": {"type": "string"},
                  "dependency_id": {"type": "string"},
                  "matrix_group_id": {"type": "string"}
                }
              },
              "attempts": {"type": "array", "items": {"$ref": "#/$defs/verificationAttempt"}}
            }
          }
        },
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_completion_timings": {"$ref": "#/$defs/phaseTimings"},
        "warnings": {
          "type": "array",
          "description": "Follow-up for retained diagnostic reports; does not alter verdict, classification, or result_digest.",
          "items": {"$ref": "#/$defs/warning"}
        },
        "client_interruption": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signal", "resource_id", "cancellation_acknowledged", "status_command", "cancel_command"],
          "properties": {
            "signal": {"type": "string", "minLength": 1},
            "resource_id": {"type": "string", "minLength": 1},
            "cancellation_acknowledged": {"type": "boolean"},
            "status_command": {"type": "string", "minLength": 1},
            "cancel_command": {"type": "string", "minLength": 1}
          }
        },
        "client_error": {"$ref": "#/$defs/verificationClientError"}
      }
    },
    "verificationRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "digest", "rerunnable", "change_mode", "request_secrets", "retry_count", "retry_provided", "source"],
      "properties": {
        "schema_version": {"const": "readyci.verification_recipe.v1"},
        "purpose": {"const": "execution"},
        "warm_checks": {"type":"array", "items":{"type":"string", "minLength":1}},
        "skip_confirm": {"type":"boolean"},
        "skip_warm": {"type":"boolean"},
        "command": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "rerunnable": {"type": "boolean"},
        "check": {"type": "string"},
        "change_mode": {"enum": ["working", "staged", "all"]},
        "request_secrets": {"type": "boolean"},
        "retry_count": {"type": "integer", "minimum": 0, "maximum": 9},
        "retry_provided": {"type": "boolean"},
        "source": {"$ref": "#/$defs/verificationSourceRecipe"}
      }
    },
    "verificationSourceRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exclude_patterns", "default_exclude_patterns", "default_untracked_exclude_patterns", "reviewed_fixtures", "include_untracked", "use_project_ignore"],
      "properties": {
        "exclude_patterns": {"type": "array", "items": {"type": "string"}},
        "default_exclude_patterns": {"type": "array", "items": {"type": "string"}},
        "default_untracked_exclude_patterns": {"type": "array", "items": {"type": "string"}},
        "reviewed_fixtures": {"type": "array", "items": {"$ref": "#/$defs/reviewedFixture"}, "uniqueItems": true},
        "include_untracked": {"type": "boolean"},
        "use_project_ignore": {"type": "boolean"},
        "upload_baseline_session_id": {"type": "string", "maxLength": 160},
        "source_policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_scopes": {"type": "array", "minItems": 2, "maxItems": 256, "items": {"$ref": "#/$defs/sourcePolicyBinding"}}
      }
    },
    "reviewedFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {"not": {"pattern": "[\\\\*?\\[\\]\\x00-\\x1F\\x7F]"}},
            {"not": {"pattern": "^(?:/|\\./|[A-Za-z]:)|/$|//"}},
            {"not": {"pattern": "(?:^|/)\\.\\.?(?:/|$)"}},
            {"not": {"pattern": "(?:^|/)\\.[gG][iI][tT](?:/|$)"}}
          ]
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sourcePolicyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "exclude_patterns", "default_exclude_patterns", "default_untracked_exclude_patterns", "reviewed_fixtures", "include_untracked", "project_ignore_used"],
      "properties": {
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "exclude_patterns": {"type": ["array", "null"], "items": {"type": "string"}},
        "default_exclude_patterns": {"type": ["array", "null"], "items": {"type": "string"}},
        "default_untracked_exclude_patterns": {"type": ["array", "null"], "items": {"type": "string"}},
        "reviewed_fixtures": {
          "type": ["array", "null"],
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
            "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
          }
        },
        "include_untracked": {"type": "boolean"},
        "project_ignore_used": {"const": false}
      }
    },
    "verificationNodeSource": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_digest", "changed_files", "policy"],
      "properties": {
        "snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "baseline_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "changed_files": {"type": "array", "items": {"type": "string"}},
        "policy": {"$ref": "#/$defs/sourcePolicyBinding"}
      }
    },
    "verificationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "authority", "fail_fast", "nodes"],
      "properties": {
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "authority": {"enum": ["client_proposed", "server_authorized"]},
        "fail_fast": {"type": "boolean"},
        "matrix_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "max_parallel", "fail_fast"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "max_parallel": {"type": "integer", "minimum": 0},
              "fail_fast": {"type": "boolean"}
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "kind", "phase", "condition", "required", "retry", "run"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "phase": {"enum": ["warm", "verify"]},
              "condition": {"enum": ["always", "on_success"]},
              "matrix_group": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "success_depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "retry": {
                "type": "object",
                "additionalProperties": false,
                "required": ["max_attempts"],
                "properties": {
                  "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
                  "retryable_classifications": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
                }
              },
              "source": {"$ref": "#/$defs/verificationNodeSource"},
              "run": {
                "type": "object",
                "properties": {
                  "environment_requirements": {"$ref": "#/$defs/environmentRequirements"}
                }
              }
            }
          }
        }
      }
    },
    "verificationAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "attempt", "status", "retryable", "artifact_count", "retained_artifact_count", "artifacts_available", "evidence_attested", "created_at"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "attempt": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "classification": {"type": "string"},
        "retryable": {"type": "boolean"},
        "artifact_count": {"type": "integer", "minimum": 0},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "retained_artifact_count": {"type": "integer", "minimum": 0},
        "artifacts_available": {"type": "boolean"},
        "evidence_attested": {"type": "boolean"},
        "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence_receipt": {"$ref": "#/$defs/runnerEvidenceReceipt"},
        "queued_at": {"type": "string", "format": "date-time"},
        "claimed_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "runnerEvidenceAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "run_group_id", "logical_child_id", "attempt", "workspace_digest", "execution_digest", "status", "exit_code"],
      "properties": {
        "schema_version": {"const": "readyci.runner_evidence.v1"},
        "run_id": {"type": "string", "minLength": 1},
        "run_group_id": {"type": "string", "minLength": 1},
        "logical_child_id": {"type": "string", "minLength": 1},
        "attempt": {"type": "integer", "minimum": 1},
        "workspace_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "execution_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "status": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "runnerEvidenceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "attestation", "worker_id", "worker_version", "worker_release_state", "worker_release_digest", "claim_sequence", "artifact_count", "artifact_digest", "attested_at", "digest"],
      "properties": {
        "schema_version": {"const": "readyci.runner_evidence_receipt.v3"},
        "attestation": {"$ref": "#/$defs/runnerEvidenceAttestation"},
        "worker_id": {"type": "string", "minLength": 1},
        "worker_version": {"type": "string", "minLength": 1},
        "worker_release_state": {"const": "production"},
        "worker_release_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "claim_sequence": {"type": "integer", "minimum": 1},
        "artifact_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifact_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "attested_at": {"type": "string", "format": "date-time"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"artifact_count": {"const": 1}}},
          "then": {"required": ["artifact_content_sha256"]}
        },
        {
          "if": {"properties": {"artifact_count": {"const": 0}}},
          "then": {"not": {"required": ["artifact_content_sha256"]}}
        }
      ]
